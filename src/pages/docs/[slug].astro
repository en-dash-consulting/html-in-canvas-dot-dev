---
/**
 * Individual doc page — /docs/{slug}/
 * Renders a spec markdown file with sidebar navigation.
 */
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import BrowserSetupSteps from '../../components/BrowserSetupSteps.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => ({
    params: { slug: doc.id },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);

// HowTo JSON-LD for the browser-support doc — its "How to try it"
// section is a short setup guide that maps cleanly onto
// schema.org/HowTo and can surface as step-by-step rich results. Kept
// in sync manually with the markdown (sync-spec-docs.mjs rewrites the
// steps from the upstream README, so revisit here if they change).
const SITE_URL = 'https://html-in-canvas.dev';
const howToJsonLd =
  doc.id === 'browser-support'
    ? {
        '@context': 'https://schema.org',
        '@type': 'HowTo',
        name: 'Use HTML-in-Canvas in Chrome',
        description:
          'HTML-in-Canvas is on by default in Chrome 157+. On Chromium 147–156 or Brave, turn on the canvas-draw-element flag.',
        totalTime: 'PT2M',
        tool: [{ '@type': 'HowToTool', name: 'Google Chrome 157 or later' }],
        step: [
          {
            '@type': 'HowToStep',
            position: 1,
            name: 'Update Chrome',
            text: 'Update Chrome to version 157 or later from chrome://settings/help. The API is on by default.',
            url: 'https://www.google.com/chrome/',
          },
          {
            '@type': 'HowToStep',
            position: 2,
            name: 'Older Chromium or Brave: turn on the flag',
            text: 'On Chromium 147–156 or Brave, visit chrome://flags/#canvas-draw-element, enable it, and relaunch.',
          },
          {
            '@type': 'HowToStep',
            position: 3,
            name: 'Load a demo',
            text: 'Load any demo from the demo gallery to confirm the API is available.',
            url: `${SITE_URL}/demos/`,
          },
        ],
      }
    : null;
---

<DocsLayout title={doc.data.title} currentSlug={doc.id}>
  {howToJsonLd && (
    <Fragment slot="head">
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(howToJsonLd)}
      />
    </Fragment>
  )}
  {doc.id === 'browser-support' && (
    <div class="browser-support-quickstart">
      <BrowserSetupSteps headingLevel="h2" />
    </div>
  )}
  <Content />
</DocsLayout>

<style>
  .browser-support-quickstart {
    margin-bottom: 2rem;
  }
</style>

const viewBox = variant === 'symbol' ? '0 0 196 170' : '0 0 847.64 180';
const a11y: Record<string, string> = label
  ? { role: 'img', 'aria-label': label }
  : { 'aria-hidden': 'true' };
const markup = variant === 'symbol' ? SYMBOL : WORDMARK;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={viewBox}
  class={`gv-logo gv-logo--${variant} ${extraClass}`.trim()}
  focusable="false"
  {...a11y}
  set:html={markup}
/>

<style>
  .gv-logo {
    display: inline-block;
    height: 1em;
    width: auto;
    vertical-align: -0.12em;
    --gv-point: var(--color-teal);
  }
</style>

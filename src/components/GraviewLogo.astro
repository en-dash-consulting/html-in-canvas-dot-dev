/**
 * Graview logo — the official mark from graview.dev's brand kit
 * (docs/site/brand/graview-primary.svg in the graview repo), recoloured
 * to `currentColor` so it follows the site theme: navy on light, white
 * on dark, with the turquoise point kept via `--gv-point`.
 *
 * `variant="symbol"` renders just the isometric mark;
 * `variant="wordmark"` renders mark + "graview" wordmark (≈4.7:1).
 * Decorative by default (aria-hidden); pass `label` to expose it as an
 * image with that accessible name instead.
 */
interface Props {
  variant?: 'symbol' | 'wordmark';
  /** Accessible name. Omit for a purely decorative logo. */
  label?: string;
  class?: string;
}


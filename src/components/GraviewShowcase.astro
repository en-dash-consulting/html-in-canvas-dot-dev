---
/**
 * Graview showcase hero — "see HTML-in-Canvas in production".
 *
 * Sits directly under the landing hero and points visitors at the two
 * places the API is doing real work: graview.dev (the open framework)
 * and graview.cloud (the hosted product built on it). Graview's
 * renderer captures each live DOM view with the HTML-in-Canvas API and
 * composites the captures as planes at depth — so the illustration
 * here is a miniature of exactly that pipeline.
 *
 * Flag ON: a `<canvas layoutsubtree>` hosts three small DOM "views"
 * (the panels of a tiny Graview-style app). A 2D context draws each one
 * with `drawElementImage` under a leaning affine transform at one of
 * three depths — back plane blurred and dimmed, front plane sharp with
 * a shadow — with connectors stroked between them. The planes bob on
 * their own phases and parallax against the pointer.
 *
 * Flag OFF (and non-Chromium): the same three panels are rendered as
 * ordinary DOM with the same transforms applied by CSS — which is also
 * Graview's own shipping "DOM path", so the fallback is honest rather
 * than a screenshot. Both variants are decorative (`aria-hidden`); the
 * real content is the heading, copy, and the two outbound links.
 */

import GraviewPanel from './GraviewPanel.astro';
import GraviewLogo from './GraviewLogo.astro';

const GRAVIEW_DEV = 'https://graview.dev';
const GRAVIEW_CLOUD = 'https://graview.cloud';

// Both spellings of the canvas opt-in: `layoutsubtree` for Chromium
// ≤156 (Brave Stable, older Canary) and `content="drawable"` for Chrome
// Canary 157+, which renamed the attribute. Each build ignores the one
// it doesn't know. Neither is in Astro's typed HTML attribute surface.
const canvasAttrs: Record<string, string> = {
  layoutsubtree: '',
  content: 'drawable',
};

---

<section class="gv" id="graview" aria-labelledby="gv-heading">
  <div class="gv-inner">
    {/* ============ COPY ============ */}
    <div class="gv-copy">
      <p class="gv-eyebrow">In production</p>
      <h2 id="gv-heading" class="gv-heading">
        See it in action in
        <GraviewLogo variant="wordmark" label="Graview" class="gv-heading-logo" />
      </h2>
      <p class="gv-sub">
        Graview builds apps as isometric scenes. Its WebGPU renderer
        captures every live view with the HTML-in-Canvas API, uploads
        the capture as a texture, and composites the planes with depth
        and blur — the shader does what CSS can't, while the DOM
        underneath stays real: focusable, editable, accessible.
      </p>

      <ul class="gv-links" aria-label="Graview sites">
        <li>
          <a
            class="gv-link gv-link--dev"
            href={GRAVIEW_DEV}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="gv-link-host">graview.dev</span>
            <span class="gv-link-role">The open framework</span>
            <span class="gv-link-desc">
              Declare your domain once — kinds, fields, edges, acts, rules
              — and the spatial interface, routed pages, checks, and agent
              tools are derived from it.
            </span>
            <span class="gv-link-cta">
              Visit graview.dev
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7" /><path d="M7 7h10v10" /></svg>
            </span>
          </a>
        </li>
        <li>
          <a
            class="gv-link gv-link--cloud"
            href={GRAVIEW_CLOUD}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="gv-link-host">graview.cloud</span>
            <span class="gv-link-role">The hosted product</span>
            <span class="gv-link-desc">
              One message in ChatGPT or Claude becomes a shared app at its
              own address — live for everyone you invite, with rules that
              flag problems and a history you can undo.
            </span>
            <span class="gv-link-cta">
              Visit graview.cloud
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7" /><path d="M7 7h10v10" /></svg>
            </span>
          </a>
        </li>
      </ul>
    </div>

    {/* ============ SCENE (decorative) ============ */}
    <div class="gv-stage" aria-hidden="true">
      {/* Flag-on: capture canvas. The panels are layoutsubtree children
          — laid out by the browser, painted only through the canvas.
          pointer-events are off so the browser's hit-test never
          descends into the captured subtree. */}
      <canvas class="gv-canvas" {...canvasAttrs}>
        <GraviewPanel kind="lens" drawable />
        <GraviewPanel kind="rule" drawable />
        <GraviewPanel kind="kind" drawable />
      </canvas>

      <span class="gv-live-badge gv-live-badge--on">
        <span class="gv-live-dot"></span>
        Live · <code>drawElementImage</code> → planes at depth
      </span>

      {/* Flag-off: the DOM path. Same panels, transforms applied by CSS. */}
      <div class="gv-dom">
        <svg class="gv-dom-links" viewBox="0 0 520 360" preserveAspectRatio="none" aria-hidden="true">
          <path d="M345 81 C 240 81, 240 260, 133 260" />
          <path d="M133 260 C 236 260, 236 245, 339 245" />
        </svg>
        <GraviewPanel kind="lens" class="gv-panel--dom" />
        <GraviewPanel kind="rule" class="gv-panel--dom" />
        <GraviewPanel kind="kind" class="gv-panel--dom" />
        <span class="gv-live-badge gv-live-badge--off">
          <span class="gv-live-dot gv-live-dot--off"></span>
          DOM path · flip the flag for the captured version
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  /**
   * Flag-on pipeline (2D):
   *   1. The canvas bitmap is sized 1:1 with its CSS box (layoutsubtree
   *      lays children out against the bitmap size — no DPR scaling,
   *      see CLAUDE.md / project memory).
   *   2. Every frame we `requestPaint()`; inside `onpaint` each panel is
   *      drawn with `drawElementImage` under a leaning affine transform
   *      at one of three depths. Back → front: smaller, blurrier,
   *      dimmer → full size, sharp, shadowed. Connectors are stroked
   *      between panel anchors before the panels so they sit beneath.
   *   3. Each plane bobs on its own phase and parallaxes against the
   *      pointer — far planes move less, near planes more.
   */
  type DrawElementFn = (el: Element, x: number, y: number) => unknown;

  interface DrawElementContext extends CanvasRenderingContext2D {
    drawElementImage?: DrawElementFn;
    drawElement?: DrawElementFn;
  }

  interface LayoutsubtreeCanvas extends HTMLCanvasElement {
    requestPaint?: () => void;
    onpaint: ((this: LayoutsubtreeCanvas, ev: Event) => void) | null;
  }

  interface Plane {
    el: HTMLElement;
    /** Resting anchor in unit stage coords (0–1). */
    u: number;
    v: number;
    /** Depth 0 = back, 1 = front. */
    depth: number;
    /** Bob phase offset. */
    phase: number;
  }

  function initGraviewShowcase() {
    const stage = document.querySelector<HTMLElement>('.gv-stage');
    const canvas = stage?.querySelector<LayoutsubtreeCanvas>('.gv-canvas');
    if (!stage || !canvas) return;
    if (document.documentElement.dataset.flagSupported !== 'true') return;
    if (canvas.dataset.gvInit === 'true') return;
    canvas.dataset.gvInit = 'true';

    const ctx = canvas.getContext('2d') as DrawElementContext | null;
    if (!ctx) return;
    // Bind, or the call lands with no `this` and throws "Illegal
    // invocation" — silently, inside the try below.
    const draw = (ctx.drawElementImage ?? ctx.drawElement)?.bind(ctx);
    if (!draw) return;

    const panelEls = {
      kind: canvas.querySelector<HTMLElement>('[data-panel="kind"]'),
      lens: canvas.querySelector<HTMLElement>('[data-panel="lens"]'),
      rule: canvas.querySelector<HTMLElement>('[data-panel="rule"]'),
    };
    if (!panelEls.kind || !panelEls.lens || !panelEls.rule) return;

    // Back-to-front draw order. Anchors are the panel's top-left in
    // unit coordinates of the stage.
    const planes: Plane[] = [
      { el: panelEls.lens, u: 0.50, v: 0.10, depth: 0, phase: 0.0 },
      { el: panelEls.rule, u: 0.08, v: 0.52, depth: 0.5, phase: 2.1 },
      { el: panelEls.kind, u: 0.46, v: 0.42, depth: 1, phase: 4.2 },
    ];

    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isLight = () =>
      document.documentElement.getAttribute('data-theme') === 'light';

    let w = 1;
    let h = 1;
    let pointerX = 0; // -1 … 1
    let pointerY = 0;
    let smoothX = 0;
    let smoothY = 0;
    let start = performance.now();

    function size() {
      const rect = stage!.getBoundingClientRect();
      w = Math.max(1, Math.round(rect.width));
      h = Math.max(1, Math.round(rect.height));
      canvas!.width = w;
      canvas!.height = h;
      canvas!.requestPaint?.();
    }

    // The lean every plane shares: a slight right-leaning shear plus
    // a vertical squash — reads as a card standing in an isometric
    // room without needing real 3D.
    const LEAN_X = 0.0;
    const LEAN_Y = 0.22;
    const SQUASH = 0.94;

    interface Placed {
      plane: Plane;
      x: number;
      y: number;
      scale: number;
      cx: number;
      cy: number;
    }

    function place(now: number): Placed[] {
      const t = (now - start) / 1000;
      // Shrink everything together on narrow stages so the front plane
      // still fits (panels are fixed-size DOM; the stage isn't).
      const fit = Math.max(0.6, Math.min(1, w / 520));
      const out: Placed[] = [];
      for (const p of planes) {
        const scale = (0.74 + p.depth * 0.26) * fit;
        const bob = reduceMotion ? 0 : Math.sin(t * 0.9 + p.phase) * (4 + p.depth * 6);
        const par = reduceMotion ? 0 : 6 + p.depth * 18;
        const x = p.u * w + smoothX * par;
        const y = p.v * h + bob - smoothY * par * 0.6;
        const pw = p.el.offsetWidth * scale;
        const ph = p.el.offsetHeight * scale;
        out.push({ plane: p, x, y, scale, cx: x + pw / 2, cy: y + ph / 2 + pw * LEAN_Y * 0.5 });
      }
      return out;
    }

    function strokeConnectors(placed: Placed[]) {
      const light = isLight();
      ctx!.save();
      ctx!.setTransform(1, 0, 0, 1, 0, 0);
      ctx!.lineWidth = 1.5;
      ctx!.setLineDash([4, 5]);
      for (let i = 0; i < placed.length - 1; i++) {
        const a = placed[i];
        const b = placed[i + 1];
        const grad = ctx!.createLinearGradient(a.cx, a.cy, b.cx, b.cy);
        grad.addColorStop(0, light ? 'rgba(0, 106, 88, 0.55)' : 'rgba(0, 229, 185, 0.6)');
        grad.addColorStop(1, light ? 'rgba(79, 40, 192, 0.6)' : 'rgba(154, 124, 255, 0.7)');
        ctx!.strokeStyle = grad;
        ctx!.beginPath();
        ctx!.moveTo(a.cx, a.cy);
        const mx = (a.cx + b.cx) / 2;
        ctx!.bezierCurveTo(mx, a.cy, mx, b.cy, b.cx, b.cy);
        ctx!.stroke();
      }
      ctx!.restore();
    }

    canvas.onpaint = () => {
      ctx!.reset();
      const placed = place(performance.now());
      const light = isLight();

      strokeConnectors(placed);

      for (const { plane, x, y, scale } of placed) {
        const d = plane.depth;
        ctx!.save();
        // Far planes: blurred, dimmed; near: sharp with a lifted shadow.
        const blur = (1 - d) * 2.6;
        ctx!.filter = blur > 0.05 ? `blur(${blur.toFixed(2)}px)` : 'none';
        ctx!.globalAlpha = 0.55 + d * 0.45;
        ctx!.shadowColor = light ? 'rgba(20, 20, 42, 0.28)' : 'rgba(0, 0, 0, 0.55)';
        ctx!.shadowBlur = 10 + d * 22;
        ctx!.shadowOffsetY = 6 + d * 10;
        ctx!.setTransform(scale, LEAN_Y * scale, LEAN_X * scale, SQUASH * scale, x, y);
        try {
          draw!(plane.el, 0, 0);
        } catch {
          // No cached paint record yet on the very first tick in some
          // tabs; the next frame requests paint again.
        }
        ctx!.restore();
      }
    };

    function onPointer(ev: PointerEvent) {
      const r = stage!.getBoundingClientRect();
      pointerX = ((ev.clientX - r.left) / r.width) * 2 - 1;
      pointerY = ((ev.clientY - r.top) / r.height) * 2 - 1;
    }
    function onLeave() {
      pointerX = 0;
      pointerY = 0;
    }
    if (!reduceMotion) {
      stage.addEventListener('pointermove', onPointer);
      stage.addEventListener('pointerleave', onLeave);
    }

    // Only animate while on screen — the hero above already owns a
    // WebGL loop; no need to burn frames on a stage nobody sees.
    let visible = true;
    const io = new IntersectionObserver((entries) => {
      visible = entries.some((e) => e.isIntersecting);
    });
    io.observe(stage);

    let rafId = 0;
    function frame() {
      rafId = requestAnimationFrame(frame);
      if (!visible) return;
      smoothX += (pointerX - smoothX) * 0.08;
      smoothY += (pointerY - smoothY) * 0.08;
      canvas!.requestPaint?.();
    }

    size();
    const ro = new ResizeObserver(() => size());
    ro.observe(stage);

    // Repaint when the theme flips so connector/shadow colors follow.
    const mo = new MutationObserver(() => canvas!.requestPaint?.());
    mo.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    if (reduceMotion) {
      // One settled paint; layoutsubtree may need a tick for paint
      // records, so nudge again shortly after.
      canvas.requestPaint?.();
      setTimeout(() => canvas!.requestPaint?.(), 120);
    } else {
      rafId = requestAnimationFrame(frame);
    }

    document.addEventListener(
      'astro:before-swap',
      () => {
        cancelAnimationFrame(rafId);
        ro.disconnect();
        io.disconnect();
        mo.disconnect();
      },
      { once: true },
    );
  }

  initGraviewShowcase();
  document.addEventListener('astro:after-swap', initGraviewShowcase);
</script>

<style>
  /* ===== Section ===== */
  .gv {
    position: relative;
    /* Anchor target for the hero pill and the top banner; clear the
       sticky nav when jumped to. */
    scroll-margin-top: calc(var(--nav-height) + 0.5rem);
    padding: 3.5rem 0 3rem;
    border-top: 1px solid var(--border-subtle);
  }

  .gv-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 2.5rem;
    align-items: center;
  }

  /* ===== Copy ===== */
  .gv-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-purple-text);
    margin: 0 0 0.75rem;
  }

  .gv-heading {
    font-size: clamp(1.75rem, 3.6vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 1rem;
  }

  /* Official wordmark inline in the heading — sized to the cap height
     so it reads as part of the sentence, not a pasted-in image. */
  .gv-heading :global(.gv-heading-logo) {
    height: 0.92em;
    vertical-align: -0.08em;
    margin-left: 0.1em;
    color: var(--text-primary);
  }

  .gv-sub {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.65;
    margin: 0 0 1.5rem;
    max-width: 38rem;
  }

  .gv-links {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.875rem;
    margin: 0;
    padding: 0;
  }

  .gv-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    height: 100%;
    padding: 1rem 1.1rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    color: var(--text-primary);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.12s ease, box-shadow 0.15s ease;
  }

  .gv-link:hover {
    text-decoration: none;
    color: var(--text-primary);
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 10px 30px -18px rgba(108, 65, 240, 0.6);
  }

  .gv-link:focus-visible {
    outline: 2px solid var(--color-purple);
    outline-offset: var(--focus-offset);
  }

  .gv-link-host {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .gv-link--dev .gv-link-host {
    color: var(--accent-teal-text);
  }

  .gv-link--cloud .gv-link-host {
    color: var(--accent-purple-text);
  }

  .gv-link-role {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .gv-link-desc {
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--text-secondary);
    margin-top: 0.35rem;
    flex: 1;
  }

  .gv-link-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--link);
  }

  .gv-link:hover .gv-link-cta {
    text-decoration: underline;
  }

  /* ===== Stage ===== */
  .gv-stage {
    position: relative;
    isolation: isolate;
    /* With aspect-ratio + min-height the box's min-content width is
       transferred from the height, which would widen the grid column
       past the viewport on phones; opt out of that contribution. */
    min-width: 0;
    aspect-ratio: 13 / 9;
    min-height: 300px;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--border-color);
    background:
      radial-gradient(ellipse 70% 60% at 25% 20%, rgba(108, 65, 240, 0.22), transparent 70%),
      radial-gradient(ellipse 60% 60% at 80% 85%, rgba(0, 229, 185, 0.16), transparent 70%),
      var(--bg-secondary);
  }

  /* Isometric floor grid behind the planes. */
  .gv-stage::before {
    content: '';
    position: absolute;
    inset: -40%;
    z-index: 0;
    background-image:
      linear-gradient(rgba(154, 124, 255, 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(154, 124, 255, 0.12) 1px, transparent 1px);
    background-size: 36px 36px;
    transform: rotate(30deg) skewX(-28deg) scaleY(0.86);
    mask-image: radial-gradient(ellipse 60% 55% at 50% 55%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 60% 55% at 50% 55%, #000 30%, transparent 75%);
    pointer-events: none;
  }

  :global([data-theme='light']) .gv-stage::before {
    background-image:
      linear-gradient(rgba(79, 40, 192, 0.14) 1px, transparent 1px),
      linear-gradient(90deg, rgba(79, 40, 192, 0.14) 1px, transparent 1px);
  }

  .gv-canvas {
    display: none; /* flag-on only */
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
  }

  /* ===== Live badge ===== */
  .gv-live-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.28rem 0.6rem;
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--accent-teal-text);
    background: rgba(0, 229, 185, 0.08);
    border: 1px solid rgba(0, 229, 185, 0.35);
    border-radius: 999px;
    backdrop-filter: blur(6px);
    pointer-events: none;
  }

  .gv-live-badge code {
    font-size: 0.64rem;
    padding: 0 0.3em;
    background: rgba(0, 0, 0, 0.25);
    color: inherit;
  }

  .gv-live-badge--off {
    color: var(--accent-orange-text);
    background: rgba(255, 89, 38, 0.08);
    border-color: rgba(255, 89, 38, 0.4);
  }

  .gv-live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-teal-text);
    animation: gv-live-pulse 1.8s ease-out infinite;
  }

  .gv-live-dot--off {
    background: var(--accent-orange-text);
    animation: none;
  }

  @keyframes gv-live-pulse {
    0% { box-shadow: 0 0 0 0 rgba(0, 229, 185, 0.5); }
    70% { box-shadow: 0 0 0 8px rgba(0, 229, 185, 0); }
    100% { box-shadow: 0 0 0 0 rgba(0, 229, 185, 0); }
  }

  /* ===== DOM path (flag-off) ===== */
  .gv-dom {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .gv-dom-links {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--accent-purple-text);
    stroke-width: 1.5;
    stroke-dasharray: 4 5;
    opacity: 0.75;
  }

  @media (prefers-reduced-motion: reduce) {
    .gv-live-dot {
      animation: none;
    }
  }

  /* ===== Flag gating ===== */
  :global([data-flag-supported='true']) .gv-canvas {
    display: block;
  }

  :global([data-flag-supported='true']) .gv-dom {
    display: none;
  }

  :global([data-flag-supported='true']) .gv-live-badge--on {
    display: inline-flex;
  }

  .gv-live-badge--on {
    display: none;
  }

  /* ===== Responsive ===== */
  @media (max-width: 900px) {
    .gv-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }

    .gv-stage {
      order: -1;
      aspect-ratio: 16 / 10;
      min-height: 260px;
    }
  }

  @media (max-width: 560px) {
    .gv {
      padding: 2.5rem 0 2rem;
    }

    .gv-links {
      grid-template-columns: 1fr;
    }

    .gv-stage {
      aspect-ratio: 4 / 3;
      /* No min-height here: an aspect-ratio box transfers min-height
         into a minimum width (240px × 4/3 = 320px), which is wider
         than a phone's content column. */
      min-height: 0;
    }
  }
</style>

<style is:global>
  /* Panel styles live in a global block because the panels are rendered
     by the GraviewPanel child component, outside this component's scope
     hash. Every selector is prefixed `.gv-` to keep the leak contained. */

  /* layoutsubtree children: laid out inside the canvas, painted only via
     drawElementImage. No pointer events so the browser never hit-tests
     into the captured subtree. */
  .gv-canvas > .gv-panel {
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: none;
  }

  /* ===== Panels (shared between both paths) ===== */
  .gv-panel {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    width: 200px;
    padding: 0.7rem 0.8rem 0.75rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 0.72rem;
    line-height: 1.35;
  }

  .gv-panel--lens {
    width: 230px;
  }

  .gv-panel--rule {
    width: 210px;
